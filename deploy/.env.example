# Copy this file to /opt/music-dreamer/deploy/.env on ECS and replace every
# CHANGE_ME value. Never commit the copied .env file.

COMPOSE_PROJECT_NAME=music-dreamer
MUSIC_DREAMER_PUBLIC_HOST=_
MUSIC_DREAMER_ADMIN_HOST=admin.localhost

MYSQL_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_ROOT_PASSWORD
MUSIC_DREAMER_IDENTITY_DB_USERNAME=music_dreamer_identity_app
MUSIC_DREAMER_IDENTITY_DB_PASSWORD=CHANGE_ME_IDENTITY_PASSWORD
MUSIC_DREAMER_CATALOG_DB_USERNAME=music_dreamer_catalog_app
MUSIC_DREAMER_CATALOG_DB_PASSWORD=CHANGE_ME_CATALOG_PASSWORD
MUSIC_DREAMER_INTERACTION_DB_USERNAME=music_dreamer_interaction_app
MUSIC_DREAMER_INTERACTION_DB_PASSWORD=CHANGE_ME_INTERACTION_PASSWORD
MUSIC_DREAMER_MEDIA_DB_USERNAME=music_dreamer_media_app
MUSIC_DREAMER_MEDIA_DB_PASSWORD=CHANGE_ME_MEDIA_PASSWORD

MUSIC_DREAMER_IDENTITY_MEDIA_COOKIE_SECURE=false
MUSIC_DREAMER_MEDIA_STORAGE_ROOT=/var/lib/music-dreamer/media
